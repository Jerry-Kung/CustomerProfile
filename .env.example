# 复制为项目根目录下的 .env
# 应用与日志
APP_ENV=local
LOG_LEVEL=INFO
HTTP_LOG_LEVEL=WARNING
LOG_DIR=logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days

# API；Compose 会覆盖容器内端口，只使用 HOST_API_PORT
API_HOST=0.0.0.0
API_PORT=8000
HOST_API_PORT=18008

# 工作流平台：dify / qingtian / runner
WORKFLOW_PLATFORM=dify

# Dify
DIFY_BASE_URL=https://dify.example.com
DIFY_RUN_URL=https://dify.example.com/v1/workflows/run
DIFY_API_KEY_TEST=
DIFY_API_KEY_PRODUCTION=
DIFY_INVITATION_STRATEGY_API_KEY=
DIFY_USER_ID=customer-profile-service
DIFY_IMAGE_MODE=file_id
DIFY_STREAM_INIT_TIMEOUT_MS=30000
DIFY_POLL_INTERVAL_MS=2000
DIFY_POLL_TIMEOUT_MS=2400000

# 擎天：本地画像、邀请策略、商用画像分别使用独立 Key
QINGTIAN_BASE_URL=https://qingtian.dfmc.com.cn/api/proxy/api/v1
QINGTIAN_API_KEY_TEST=
QINGTIAN_API_KEY_PRODUCTION=
QINGTIAN_INVITATION_STRATEGY_API_KEY=
QINGTIAN_COMMERCIAL_API_KEY_TEST=
QINGTIAN_COMMERCIAL_API_KEY_PRODUCTION=
QINGTIAN_USER_ID=customer-profile-service
# 查询同一个 runId：间隔 2 秒，单轮最多等待 40 分钟
QINGTIAN_POLL_INTERVAL_MS=2000
QINGTIAN_POLL_TIMEOUT_MS=2400000

# 邀约 Worker、旧商用恢复 Worker 的并发和队列扫描间隔
WORKER_CONCURRENCY=8
COMMERCIAL_WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000

# 默认 Compose：新画像只交给 Runner，旧 Worker 处理邀约和已绑定运行的恢复。
# 以下闸门仅在显式启用旧画像消费者时限制旧本地／商用资源池。
WORKER_ROUTING_MODE=parallel
# 下面两项仅 local_preferred 使用
COMMERCIAL_QUEUE_THRESHOLD=5
COMMERCIAL_SPILLOVER_DELAY_SECONDS=600

# 新画像固定在 Runner 重试；Compose API 也会显式使用 single_target_v1。
RETRY_POLICY_VERSION=single_target_v1
RETRY_MAX_WORKFLOW_ATTEMPTS=3
# 同一 runId 的恢复轮询上限和最长存活时间
RETRY_MAX_POLL_RECOVERIES=3
RETRY_MAX_RUN_LIFETIME_SECONDS=7200

# 每种任务类型各自的 queued 队列上限
TASK_QUEUE_MAX_WAITING=500

# 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=customer_profile
MYSQL_PASSWORD=
MYSQL_DATABASE=customer_profile

# Runner worker starts with the other services in docker-compose.yml.
# Keep WORKFLOW_PLATFORM set to dify/qingtian for the legacy workers.
# Use the generation service address reachable from inside the Runner container.
# 使用宿主机映射端口；当前部署为 18000 -> 容器内部 18173。
PROFILE_RUNNER_BASE_URL_PRODUCTION=http://host.docker.internal:18000
PROFILE_RUNNER_BASE_URL_TEST=
PROFILE_RUNNER_REQUEST_TIMEOUT_MS=15000
PROFILE_RUNNER_POLL_INTERVAL_MS=2000
PROFILE_RUNNER_POLL_TIMEOUT_MS=2400000
PROFILE_RUNNER_TARGET_REVISION=v1
PROFILE_RUNNER_CONCURRENCY=1
PROFILE_RUNNER_TARGET_MODE=active

# 最终失败回调：接画像 API 的 M2M 服务，X-API-Key 与该服务一致。
PROFILE_FAILURE_CALLBACK_ENABLED=false
PROFILE_API_BASE_URL=http://host.docker.internal:8084
PROFILE_API_KEY=
# 可按 work_env 指向不同 API；留空复用上面地址和 Key。
PROFILE_API_BASE_URL_TEST=
PROFILE_API_BASE_URL_PRODUCTION=
PROFILE_API_KEY_TEST=
PROFILE_API_KEY_PRODUCTION=
PROFILE_FAILURE_CALLBACK_TIMEOUT_SECONDS=10
