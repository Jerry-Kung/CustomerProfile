# Common settings. Copy to .env; credentials below must be supplied.
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=18008
HOST_API_PORT=18008
# Optional logging/CORS tuning uses code defaults. See docs/worker-configuration.md.

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=customer_profile
MYSQL_PASSWORD=
MYSQL_DATABASE=customer_profile

# One shared queue; no weight, queue-depth gate or cross-platform fallback for new tasks.
RETRY_POLICY_VERSION=single_target_v1
TASK_QUEUE_MAX_WAITING=500

# QingTian target A. Concurrency is per process, not the total across replicas.
QINGTIAN_BASE_URL=https://qingtian.example/api/proxy/api/v1
QINGTIAN_USER_ID=customer-profile
QINGTIAN_API_KEY_TEST=
QINGTIAN_API_KEY_PRODUCTION=
QINGTIAN_INVITATION_STRATEGY_API_KEY=
QINGTIAN_WORKER_TARGET_ID=local-default
QINGTIAN_WORKER_TARGET_REVISION=v1
QINGTIAN_WORKER_TASK_TYPES=customer_profile,invitation_strategy
QINGTIAN_WORKER_WORK_ENVS=test,production
QINGTIAN_WORKER_CONCURRENCY=1
QINGTIAN_WORKER_TARGET_MODE=active

# Another QingTian target (commercial is only a label/legacy identity).
QINGTIAN_COMMERCIAL_API_KEY_TEST=
QINGTIAN_COMMERCIAL_API_KEY_PRODUCTION=
COMMERCIAL_WORKER_TARGET_ID=commercial-default
COMMERCIAL_WORKER_TARGET_REVISION=v1
COMMERCIAL_WORKER_TASK_TYPES=customer_profile
COMMERCIAL_WORKER_WORK_ENVS=test,production
COMMERCIAL_WORKER_CONCURRENCY=1
COMMERCIAL_WORKER_TARGET_MODE=active

# Runner is another adapter using exactly the same task/env/concurrency/mode contract.
PROFILE_RUNNER_BASE_URL_PRODUCTION=http://host.docker.internal:18000
PROFILE_RUNNER_TARGET_ID=profile-runner-production
PROFILE_RUNNER_TARGET_REVISION=v1
PROFILE_RUNNER_TASK_TYPES=customer_profile
PROFILE_RUNNER_WORK_ENVS=production
PROFILE_RUNNER_CONCURRENCY=1
PROFILE_RUNNER_TARGET_MODE=active

# Opt-in native invitation group: --profile invitation-runner.
# Each key must match CustomerProfile's INBOUND_API_KEY for that environment.
INVITATION_RUNNER_BASE_URL_TEST=http://host.docker.internal:8099
INVITATION_RUNNER_API_KEY_TEST=
INVITATION_RUNNER_BASE_URL_PRODUCTION=
INVITATION_RUNNER_API_KEY_PRODUCTION=
INVITATION_RUNNER_TARGET_ID=invitation-runner-test
INVITATION_RUNNER_TARGET_REVISION=v1
INVITATION_RUNNER_WORK_ENVS=test
INVITATION_RUNNER_CONCURRENCY=1
INVITATION_RUNNER_TARGET_MODE=active

# Business M2M root URL/key: final failure delivery AND invitation writeback verification.
PROFILE_FAILURE_CALLBACK_ENABLED=true
PROFILE_API_BASE_URL=http://host.docker.internal:8084
PROFILE_API_KEY=
