# Customer Profile —— 环境配置模板
#
# 用法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 本模板只列配置项与占位符，不含任何真实凭据。
#
# 归属原则：
#   - 端点与凭据随环境变化，放这里；
#   - 节点的模型名、temperature、prompt、重试次数属工作流定义，随节点维护在代码/资源文件中，
#     不在此处配置，以便同一份定义在测试与生产间切换端点。

# ============================================================
# 1. LLM 接入（OpenAI 兼容格式）
# ============================================================
# 本项目约定统一走 OpenAI 兼容协议，Dify 上的模型供应商凭据不随 DSL 导出，需另行提供。
LLM_BASE_URL=
LLM_API_KEY=

# 全项目统一使用同一款模型（原 Dify 中的三套模型标识已收敛，见规划文档 6.4.4）。
# 原基线：通义 qwen3.8-flash（32 处）、火山 doubao-seed-2-0-pro-260215（2 处）、
#        火山 doubao-seed-2-0-lite-260215（1 处），现全部归一。
# [必需] 该模型必须具备多模态（vision）能力：全项目有 12 个截图解析节点依赖图片输入。
# 固定参数（不在 .env 中配置，属工作流定义）：temperature=0.5。
# 模型参数另有三个开关走 .env（见下方三节），缺省均**不发该键**，沿用服务端默认。
LLM_MODEL=

# 是否启用思维链（``enable_thinking``）。
# 留空/不设 = **不发这个键**，用服务端默认值
# （原规划 §6.4.4 的“不设其他参数”仍然成立）。
# 置 false 可缩短响应时间；推理链与出共用同一个输出上限，
# 关掉后长 JSON 输出可能被截断，见差异 W51。
LLM_ENABLE_THINKING=

# 单次响应的输出上限（``max_tokens``）。留空/不设 = 不发这个键。
# **必须与 LLM_ENABLE_THINKING=false 成对出现**：关掉思维链后，服务端
# 在未指定上限时把输出卡在 8192 token，长 JSON 会被拦腰截断，
# 而异常检查不看 finish_reason，截断会静默通过。见差异 W51。
# 取值建议 128000：常用模型的上下文窗口均为 1M，128k 不会超限。
LLM_MAX_TOKENS=

# 模型服务方限流（v0.5.3 起**真正生效**；并发上限不等于速率限制）
#
# 与 MAX_CONCURRENT_REQUESTS 的分工：那个限制「同时打出去几个」，这里限制
# 「一分钟总共几个」。两个维度并存，不合并。
#
# 置空表示不限（该维度完全不生效）。
# TPM 的实现是「出网前按 prompt 长度保守预扣，拿到响应后按 usage 校正」——
# 不预扣就无从限制，不校正则长会话下持续偏差。
LLM_RPM_LIMIT=
LLM_TPM_LIMIT=

# 令牌桶容量（突发额度）。置空时取对应的 limit。
# 容量即「瞬时最多放行多少」：等于 limit 相当于不允许任何突发；适当放宽更贴近服务方
# 实际的限流窗口，也不至于让每个请求都排队等待。
LLM_RPM_BURST=
LLM_TPM_BURST=

# worker 进程数。上面的 LIMIT 是全局额度，每进程使用 LIMIT / 本值，
# 显式分配，不跨进程共享。Compose 的部署方式固定为单 worker。
# 校验：LIMIT 必须能被本值整除，否则启动即报错——避免「RPM=60 配 4 个 worker 实际
# 打到 240」这类静默超发。
WORKER_REPLICAS=1

# ============================================================
# 2. AUC 语音识别服务
# ============================================================
# 运行期实现：火山引擎语音大模型（openspeech），异步提交 + 轮询，见
# src/customer_profile/execution/auc.py。
#
# DSL 原始值 http://192.168.0.5:5005（内网自建，无鉴权）已按用户 2026-09-23 决定
# 替换：该内网服务长期不可达，改接云服务。DSL 的 /submit_analyze 与 /query_analyze
# 两个节点契约由适配层保持不变（下游两个 code 节点逐字符取自 DSL，不可改）。
#
# 注意：云服务不接受本机生成的音频文件，它要求 file_url 是**云端可达**的 URL
# （实测把本地文件放到公网地址会以 45000006 "audio download failed" 失败）。
AUC_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel
AUC_SSL_VERIFY=true
# [安全] 控制台获取的 API Key。首次以明文出现在一份未跟踪的接入样例里，
# 按 secrets_report.md 口径视为已暴露，建议轮换后再填入。
AUC_API_KEY=
AUC_RESOURCE_ID=volc.seedasr.auc

# 轮询参数：云服务由本进程轮询到终态，间隔 1s、上限 1800 次（即 30 分钟封顶）。
# 缺省值对着「录音文件大、单次识别可达 20-30 分钟」这一实测口径。
AUC_POLL_INTERVAL_S=1.0
AUC_POLL_MAX_ATTEMPTS=1800

# ============================================================
# 3. Notes / 画像回写服务
# ============================================================
# DSL 原始值：http://118.145.238.50:8084
# 路径：/api/v1/remote/config/note-attributes      （GET  Notes 模板）
#       /api/v1/remote/callback/update-profile     （POST 回写画像，有副作用）
#       /api/v1/remote/data/history/{phone}        （GET  全量历史数据）
# 直连 customer-profile-api 时使用 M2M 进程的服务根地址（8084），不带 /api/v1/remote。
PROFILE_API_BASE_URL=http://118.145.238.50:8084
# [安全] DSL 中此密钥为明文，应视为已泄露并轮换后再填入
PROFILE_API_KEY=

# ============================================================
# 4. mhero 业务中台
# ============================================================
# DSL 原始值：https://mhero.dfmc.com.cn/customer_profile/m2m_api
# 路径：/api/v1/remote/data/profile/{phone}   （GET 客户画像与人工确认 Notes）
# 直连同一 customer-profile-api M2M 实例时可与 PROFILE_API_BASE_URL 相同；
# PROFILE_API_KEY / PROFILE_MHERO_API_KEY 均填写该实例的 M2M_API_KEY。
MHERO_BASE_URL=https://mhero.dfmc.com.cn/customer_profile/m2m_api
PROFILE_MHERO_API_KEY=

# ============================================================
# 5. HTTP 连接策略
# ============================================================
# DSL 中的 timeout 为 0、retry_interval 未标单位，语义不明（见规划 Q5）。
# 此处改用显式配置承载，不把 DSL 原值直接传给 HTTP 库。
# 参考基线：AUC 接口 connect=10 / read=600 / write=600，retry_interval=500
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=600
HTTP_WRITE_TIMEOUT=600
HTTP_RETRY_ENABLED=true
HTTP_RETRY_MAX=3
HTTP_RETRY_INTERVAL_MS=500

# ============================================================
# 6. 执行器（V0.2 起使用）
# ============================================================
# 当前仅支持 SQLite；Compose 使用本地命名卷，API 与 worker 共用同一个数据库文件。
DATABASE_URL=sqlite:///./data/customer_profile.db
# 并发上限（数值待定，见规划 Q8）
# MAX_ACTIVE_RUNS 限制进程内 submit_local 路径；队列 worker 当前串行消费。
# MAX_CONCURRENT_REQUESTS 限制真实出网请求数
# （LLM + HTTP 共用，含子流程内部）。两者独立：前者不是速率限制。
#
# POST /runs 总是持久化入队；队列满时按 MAX_QUEUED_RUNS 返回 HTTP 429。
# 子运行不占该名额（主入口一次会扇出十几个子运行，否则上限一低就自锁）。
# 置空（MAX_ACTIVE_RUNS=）表示不限制。
MAX_ACTIVE_RUNS=4
MAX_CONCURRENT_REQUESTS=8

# 待跑队列的深度上限（v0.5.2 起生效）。置空表示不限。
# 这是 v0.5.1 之后 429 的新触发条件：执行已挪到 worker，API 侧不再按「运行名额」
# 判断，改为按队列深度拒绝（差异 W23）。缺省 50 是保守值（规划 Q8 无数值），非压测结论。
MAX_QUEUED_RUNS=50

# SQLite 写冲突的等待时长（毫秒）。API 与 worker 双进程共库后必需：
# 不设它时两个进程的写相遇会立刻报 "database is locked" 而不是等一会儿。
SQLITE_BUSY_TIMEOUT_MS=5000

# API、worker、Uvicorn 统一日志级别；DEBUG 额外显示节点与请求尝试。
# 关键业务提示使用中文，异常原文保留；控制台日志由 Docker 收集。
LOG_LEVEL=INFO

# 数据目录：SQLite 与运行产物的落位基准
DATA_DIR=data

# ============================================================
# 7. 固定响应回放（V0.2 起使用）
# ============================================================
# off     —— 走真实 LLM 与 HTTP 端点
# fixture —— LLM 与 HTTP 全部走本地固定响应，**不出网**。测试与影子模式用这个。
#            该模式下任何写请求都不会真的发出，符合「测试与影子模式禁止生产回写」。
REPLAY_MODE=off
# 未命中固定响应时是否直接失败。缺省 true：静默返回空响应会让「没跑通」看起来像「跑通了」。
REPLAY_STRICT=true
FIXTURE_DIR=tests/fixtures/replay

# 启动时把上次进程遗留的 **running** 运行标记为 interrupted（保留已完成结果，
# 交人工处理，不做自动续跑）。
# 注意：**只标 running，不标 queued**（v0.5.2 修正）。queued 是持久化队列里等待被
# 领取的任务，一并标成中断会让「worker 重启不丢任务」不成立。
INTERRUPT_ON_START=true

# 是否由后端托管前端构建产物（frontend/dist，V0.4 只读运行台）。
# false —— 只跑 API；测试与未装 node 的环境保持这个值。
# true  —— 在 / 挂载运行台。**要求先跑过** cd frontend && npm run build；
#          未构建时打印告警并跳过，不会让服务启动失败。
SERVE_UI=false

# ============================================================
# 8. 执行 worker（V0.5.2 起）
# ============================================================
# worker 是队列的消费者，独立进程运行：
#
#     python -m customer_profile.worker
#
# 与 API 共用一个 SQLite 文件，靠「UPDATE ... WHERE status='queued'」的原子领取
# 避免同一任务被跑两遍（不加锁、不引入中间件）。
WORKER_POLL_INTERVAL_MS=1000
# 领取后的租约时长（毫秒）。中断运行不自动重领；保留记录交人工处理。
WORKER_LEASE_MS=60000
# 续租心跳间隔（毫秒）。必须显著小于租约时长，否则长运行会被误判为「租约过期」而跑第二遍。
WORKER_HEARTBEAT_MS=20000
# worker 标识。置空时按「主机名:pid」生成。手工起第二个 worker 时用它区分归属。
WORKER_ID=

# 本进程是否**也**消费队列。
# true  —— API 进程同时充当一个消费者：单机部署与测试都不必额外起 worker，
#          「提交后立即可查、可跑」的既有契约保持成立。
# false —— 只提交不执行，执行集中到独立的 worker 进程（生产推荐，见 Dify迁移任务说明.md §4）。
INLINE_WORKER=true

# ============================================================
# 9. 生产回写开关（V0.3 起，此前漏在本模板之外）
# ============================================================
# 是否真的发送生产回写请求（POST /api/v1/remote/callback/update-profile）。
# false —— 回写节点不发请求，只产出「已跳过」的可解释结果；**运行仍显示 succeeded**。
#          因此运行台的 /runtime 端点会把这个开关报出来，避免「成功」被读成
#          「已写进生产库」。测试、冒烟与影子模式一律保持 false。
# true  —— 使用 M2M 原生 JSON 协议写入业务库：顶层 phone / batch_id / analysis_result，
#          analysis_result 为 JSON 对象；对外 outputs.result1 仍为 JSON 字符串。
# 修改部署配置后执行 docker compose up -d 重新创建 worker，restart 不会加载新环境变量。
# 端点与凭据配置、运行模式和开启步骤见 docs/runbooks/部署.md。
WRITEBACK_ENABLED=false
