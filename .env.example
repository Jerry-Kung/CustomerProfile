# Copy to ".env" in the project root. load_config() auto-loads .env (python-dotenv).
# app
APP_ENV=local
LOG_LEVEL=INFO
HTTP_LOG_LEVEL=WARNING
LOG_DIR=logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days
# HTTP API bind (microservice / container)
API_HOST=0.0.0.0
API_PORT=8000
# docker compose: host port mapped to container 8000 (see docs/deploy-and-run.md)
HOST_API_PORT=8000

# workflow platform — pick the Agent platform the worker calls.
#   dify     : original Dify workflow (uses DIFY_* vars below)
#   qingtian : DFMC self-built QingTian platform (uses QINGTIAN_* vars below)
WORKFLOW_PLATFORM=dify

# dify
DIFY_BASE_URL=http://118.145.238.55
DIFY_RUN_URL=http://118.145.238.55/v1/workflows/run
DIFY_API_KEY=app-uu0ZFj8an4bShNrd0Ys1Gs25
# Optional: separate keys per work_env for the customer_profile workflow.
# If unset, both fall back to DIFY_API_KEY above.
DIFY_API_KEY_TEST=
DIFY_API_KEY_PRODUCTION=
# Required for the invitation_strategy task type (single key; work_env handled inside the Dify workflow itself).
DIFY_INVITATION_STRATEGY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_USER_ID=klh
DIFY_IMAGE_MODE=file_id
DIFY_STREAM_INIT_TIMEOUT_MS=30000
DIFY_POLL_INTERVAL_MS=2000
DIFY_POLL_TIMEOUT_MS=900000

# qingtian (only required when WORKFLOW_PLATFORM=qingtian)
# Base URL must include the /api/proxy/api/v1 prefix; client appends /run_app_workflow and /query_run_app_process.
QINGTIAN_BASE_URL=https://qingtian.dfmc.com.cn/api/proxy/api/v1
QINGTIAN_API_KEY_TEST=
QINGTIAN_API_KEY_PRODUCTION=
QINGTIAN_INVITATION_STRATEGY_API_KEY=
QINGTIAN_USER_ID=klh
QINGTIAN_POLL_INTERVAL_MS=2000
QINGTIAN_POLL_TIMEOUT_MS=2400000

# worker (default concurrency: 8 background workflow executions per process)
WORKER_CONCURRENCY=8
# Max number of queued (waiting) tasks; submissions beyond this are rejected with a queue-full error.
TASK_QUEUE_MAX_WAITING=500

# mysql
MYSQL_HOST=118.145.238.55
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=MengShi!@#2026
MYSQL_DATABASE=customer_profile
