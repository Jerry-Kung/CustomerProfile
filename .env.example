# Customer Profile —— 环境配置模板
#
# 用法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 本模板只列配置项与占位符，不含任何真实凭据。
#
# 归属原则：
#   - 端点与凭据随环境变化，放这里；
#   - 节点的模型名、temperature、prompt、重试次数属工作流定义，随节点维护在代码/资源文件中，
#     不在此处配置，以便同一份定义在测试与生产间切换端点。

# ============================================================
# 1. LLM 接入（OpenAI 兼容格式）
# ============================================================
# 本项目约定统一走 OpenAI 兼容协议，Dify 上的模型供应商凭据不随 DSL 导出，需另行提供。
LLM_BASE_URL=
LLM_API_KEY=

# 模型路由：工作流中出现的三套模型标识，映射到实际部署的模型名。
# 通义 qwen3.8-flash 为主力（32 处引用），火山两档用于特定节点（共 3 处）。
LLM_MODEL_DEFAULT=qwen3.8-flash
LLM_MODEL_THINKING=doubao-seed-2-0-pro-260215
LLM_MODEL_LITE=doubao-seed-2-0-lite-260215

# 模型服务方限流（V0.5 起生效；并发上限不等于速率限制）
LLM_RPM_LIMIT=
LLM_TPM_LIMIT=

# ============================================================
# 2. AUC 语音识别服务
# ============================================================
# DSL 原始值：http://192.168.0.5:5005  （无鉴权，ssl_verify=false）
# 路径：/submit_analyze（提交任务）、/query_analyze（轮询结果）
AUC_BASE_URL=http://192.168.0.5:5005
AUC_SSL_VERIFY=false

# ============================================================
# 3. Notes / 画像回写服务
# ============================================================
# DSL 原始值：http://118.145.238.50:8084
# 路径：/api/v1/remote/config/note-attributes      （GET  Notes 模板）
#       /api/v1/remote/callback/update-profile     （POST 回写画像，有副作用）
#       /api/v1/remote/data/history/{phone}        （GET  全量历史数据）
PROFILE_API_BASE_URL=http://118.145.238.50:8084
# [安全] DSL 中此密钥为明文，应视为已泄露并轮换后再填入
PROFILE_API_KEY=

# ============================================================
# 4. mhero 业务中台
# ============================================================
# DSL 原始值：https://mhero.dfmc.com.cn/customer_profile/m2m_api
# 路径：/api/v1/remote/data/profile/{phone}   （GET 客户画像与人工确认 Notes）
MHERO_BASE_URL=https://mhero.dfmc.com.cn/customer_profile/m2m_api
PROFILE_MHERO_API_KEY=

# ============================================================
# 5. HTTP 连接策略
# ============================================================
# DSL 中的 timeout 为 0、retry_interval 未标单位，语义不明（见规划 Q5）。
# 此处改用显式配置承载，不把 DSL 原值直接传给 HTTP 库。
# 参考基线：AUC 接口 connect=10 / read=600 / write=600，retry_interval=500
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=600
HTTP_WRITE_TIMEOUT=600
HTTP_RETRY_ENABLED=true
HTTP_RETRY_MAX=3
HTTP_RETRY_INTERVAL_MS=500

# ============================================================
# 6. 执行器（V0.2 起使用）
# ============================================================
# 持久化：开发用 SQLite，生产优先既有 MySQL
DATABASE_URL=sqlite:///./data/customer_profile.db
# 并发上限（数值待定，见规划 Q8）
MAX_ACTIVE_RUNS=
MAX_CONCURRENT_REQUESTS=
LOG_LEVEL=INFO
