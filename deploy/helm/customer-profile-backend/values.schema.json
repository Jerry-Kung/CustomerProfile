{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "names",
    "image",
    "config",
    "secrets",
    "persistence",
    "retry",
    "workflowTargets",
    "api",
    "localWorker",
    "commercialWorker",
    "service",
    "migration"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {
      "type": "object",
      "required": [
        "APP_ENV",
        "API_PORT",
        "WORKFLOW_PLATFORM",
        "QINGTIAN_BASE_URL",
        "QINGTIAN_USER_ID",
        "MYSQL_HOST",
        "MYSQL_PORT",
        "MYSQL_DATABASE"
      ],
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "secrets": {
      "type": "object",
      "required": ["common", "local", "commercial"],
      "properties": {
        "common": {"type": "object", "minProperties": 3},
        "local": {"type": "object", "minProperties": 2},
        "commercial": {"type": "object", "minProperties": 2}
      }
    },
    "retry": {
      "type": "object",
      "required": [
        "policyVersion",
        "maxWorkflowAttempts",
        "maxPollRecoveries",
        "maxRunLifetimeSeconds"
      ],
      "properties": {
        "policyVersion": {
          "enum": [
            "throughput_first_v1",
            "local_first_v1",
            "single_target_v1"
          ]
        },
        "maxWorkflowAttempts": {"type": "integer", "minimum": 1},
        "maxPollRecoveries": {"type": "integer", "minimum": 1},
        "maxRunLifetimeSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "workflowTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "pool",
          "revision",
          "secretName",
          "mode",
          "replicas",
          "concurrency",
          "taskTypes",
          "workEnvs",
          "mountTaskUploads",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "pool": {"enum": ["local", "commercial"]},
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "secretName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "mode": {"enum": ["active", "draining", "recovery_only"]},
          "replicas": {"type": "integer", "minimum": 1},
          "concurrency": {"type": "integer", "minimum": 1},
          "taskTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["customer_profile", "invitation_strategy"]
            }
          },
          "workEnvs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["test", "production"]}
          },
          "mountTaskUploads": {"type": "boolean"},
          "terminationGracePeriodSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "imagePullPolicy": {
            "enum": ["Always", "IfNotPresent", "Never"]
          },
          "resources": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "api": {
      "type": "object",
      "required": ["replicas", "port", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "localWorker": {
      "type": "object",
      "required": ["replicas", "concurrency", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "commercialWorker": {
      "type": "object",
      "required": ["replicas", "concurrency", "queueThreshold", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "queueThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "migration": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0}
      }
    }
  }
}
